# ---- Supabase (required to save campaigns & upload images) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=ad-creatives

# ---- LinkedIn OAuth app (enables the "Connect LinkedIn" button) ----
# From your app at https://developer.linkedin.com (see LINKEDIN_SETUP.md).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must EXACTLY match an "Authorized redirect URL" on your LinkedIn app.
# Leave blank to derive it from the request origin (origin + /api/linkedin/callback).
LINKEDIN_REDIRECT_URI=
# Scopes requested at consent. Requires Marketing Developer Platform approval.
LINKEDIN_SCOPE=r_ads rw_ads r_ads_reporting

# ---- LinkedIn single-account fallback (optional; skips OAuth, for testing) ----
# A per-user connection made via the button always takes priority over these.
LINKEDIN_ACCESS_TOKEN=
# Numeric sponsored ad account id (no urn prefix), e.g. 512345678
LINKEDIN_AD_ACCOUNT_ID=
# Sponsor organization URN, e.g. urn:li:organization:1234567
LINKEDIN_ORGANIZATION_URN=
# Versioned API date (YYYYMM). Defaults to 202406.
LINKEDIN_API_VERSION=202406

# ---- Auth / sessions ----
# Secret used to sign the session cookie. Set a long random value in production.
APP_SESSION_SECRET=change-me-to-a-long-random-string
# Demo access code used when Supabase Auth is NOT configured (any email + this code signs in).
APP_ACCESS_CODE=demo1234

# ---- URL tracking template ----
# Query-string fragment appended to every destination URL.
# Placeholders: {campaign_name} {campaign_id} {audience} {date}
URL_TRACKING_TEMPLATE=utm_source=linkedin&utm_medium=paid-social&utm_campaign={campaign_name}&utm_content={campaign_id}
